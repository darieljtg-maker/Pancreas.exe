# ============================================================
#  PancreasOS - CGM Sync Worker
#  Copia este archivo como .env y complétalo:  cp .env.example .env
#  NUNCA subas el .env al repositorio (ya está en .gitignore).
# ============================================================

# --- Base de datos Neon (PostgreSQL) --------------------------
# Cadena de conexión de Neon. Usa el endpoint "pooled" para un worker
# de larga duración. Debe incluir sslmode=require.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/pancreasos?sslmode=require"

# --- Credenciales de LibreLinkUp ------------------------------
# La cuenta de LibreLinkUp del CUIDADOR (la tuya), no la de LibreLink
# que usa Gaelito en su teléfono. Gaelito debe haber aceptado la
# invitación para compartir sus datos contigo.
LIBRE_EMAIL="tu-correo@ejemplo.com"
LIBRE_PASSWORD="tu-password-de-librelinkup"


# ============================================================
#  OPCIONALES - el worker funciona sin tocar nada de aquí abajo
# ============================================================

# Región de la cuenta (us, eu, de, fr, jp, ae, au, ca, la, ru...).
# Si se omite, se detecta sola siguiendo el redirect de Abbott.
# LIBRE_REGION="us"

# Solo si tu cuenta sigue a más de un paciente. Si es el caso, el
# worker fallará al arrancar listando los IDs disponibles: copia el
# de Gaelito aquí.
# LIBRE_PATIENT_ID=""

# Versión de la app que se envía en el header. Si algún día Abbott
# empieza a responder 401 con credenciales correctas, súbela aquí.
# LIBRE_API_VERSION="4.12.0"

# Cada cuántos minutos se consulta el sensor. El Libre 2 produce una
# lectura nueva cada 5 min, así que bajarlo no aporta datos.
# SYNC_INTERVAL_MINUTES="5"

# Solo si tu tabla cgm_readings tiene columna user_id: el id de Gaelito
# en la tabla users.
# PATIENT_USER_ID=""

# Zona horaria para los logs y para columnas timestamp sin zona horaria.
# TZ="America/Mexico_City"

# debug | info | warn | error
# LOG_LEVEL="info"

# Timeout de las llamadas HTTP a Abbott, en milisegundos.
# HTTP_TIMEOUT_MS="20000"

# Rango plausible de glucosa. Fuera de esto se descarta la lectura en
# lugar de guardar un dato corrupto.
# MIN_GLUCOSE_MGDL="20"
# MAX_GLUCOSE_MGDL="600"

# Escotilla de emergencia si tu red tiene un proxy TLS que rompe la
# validación del certificado de Neon. No debería hacer falta.
# PGSSL_NO_VERIFY="false"
