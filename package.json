{
  "name": "@pancreasos/cgm-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Worker de sincronizacion: lee la glucosa del FreeStyle Libre 2 via LibreLinkUp y la inserta en Neon (PostgreSQL).",
  "main": "sync.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node sync.js",
    "once": "node sync.js --once",
    "dry-run": "node sync.js --once --dry-run",
    "doctor": "node sync.js --doctor"
  },
  "keywords": [
    "diabetes",
    "cgm",
    "freestyle-libre",
    "librelinkup",
    "neon",
    "postgres"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
